# From https://gazelleapp.io/developer/signup -> create an Integration.
# Register https://localhost:8976/callback as the redirect URL (Gazelle requires HTTPS;
# nothing listens there, `npm run auth` has you paste the redirected URL).
GAZELLE_CLIENT_ID=
GAZELLE_CLIENT_SECRET=

# Trip origin/return for the mileage log (geocoded once, cached)
GAZELLE_HOME_STREET=
GAZELLE_HOME_CITY=
GAZELLE_HOME_STATE=
GAZELLE_HOME_ZIP=

GAZELLE_TIMEZONE=America/New_York
# Optional: self-hosted OSRM instead of the public demo server
# GAZELLE_OSRM_URL=

# Read-only by default. Set to 1 to enable the tools that edit Gazelle
# (append_appointment_note, set_service_item_price).
# GAZELLE_ENABLE_WRITES=1
